<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foodmind_paper"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_brand_mark"
            android:contentDescription="@string/foodmind_logo">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_leaf"
                app:tint="@color/foodmind_green_950" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/foodmind_green_950"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/notifications"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_notifications"
            app:iconSize="20dp"
            app:iconTint="@color/foodmind_muted"
            app:strokeColor="@color/foodmind_line"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:id="@+id/content_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_mode_switch"
                android:padding="4dp"
                app:checkedButton="@id/mode_recommend"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_recommend"
                    style="@style/FoodMind.ModeButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/mode_recommend"
                    app:icon="@drawable/ic_restaurant_mode"
                    app:iconGravity="textStart"
                    app:iconSize="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_cooking"
                    style="@style/FoodMind.ModeButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/mode_cooking"
                    app:icon="@drawable/ic_chef"
                    app:iconGravity="textStart"
                    app:iconSize="17dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/page_eyebrow"
                style="@style/FoodMind.SectionEyebrow"
                android:layout_marginTop="27dp"
                android:text="@string/recommend_eyebrow" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="-2dp"
                android:text="@string/recommend_page_title"
                android:textColor="@color/foodmind_ink"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/page_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/recommend_page_support"
                android:textColor="@color/foodmind_muted"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/generator_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/foodmind_green_950"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_generator_icon">

                            <ImageView
                                android:id="@+id/generator_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_groups"
                                app:tint="@color/foodmind_green_950" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/context_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recommending_for"
                                android:textColor="@color/foodmind_green_100"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/context_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/kitchen_table_context"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/edit_context"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/edit"
                            android:textColor="@color/foodmind_green_100"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/member_signal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FoodMind.StackedAvatar"
                                android:text="MC" />

                            <TextView
                                style="@style/FoodMind.StackedAvatar"
                                android:layout_marginStart="-7dp"
                                android:background="@drawable/bg_avatar_peach"
                                android:text="JL" />

                            <TextView
                                style="@style/FoodMind.StackedAvatar"
                                android:layout_marginStart="-7dp"
                                android:background="@drawable/bg_avatar_lilac"
                                android:text="SK" />

                            <TextView
                                style="@style/FoodMind.StackedAvatar"
                                android:layout_marginStart="-7dp"
                                android:background="@drawable/bg_avatar_butter"
                                android:text="NK" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/signal_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/shared_ratings"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/signal_support"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/enough_signal"
                                android:textColor="@color/foodmind_green_100"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/context_one"
                            style="@style/FoodMind.GeneratorChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/context_time" />

                        <TextView
                            android:id="@+id/context_two"
                            style="@style/FoodMind.GeneratorChip"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/context_range" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/context_three"
                            style="@style/FoodMind.GeneratorChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/context_budget" />

                        <TextView
                            android:id="@+id/context_four"
                            style="@style/FoodMind.GeneratorChip"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/context_constraint" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="25dp"
                        android:background="#2D5A47" />

                    <TextView
                        android:id="@+id/generator_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:letterSpacing="0.06"
                        android:text="@string/foodmind_recommendation"
                        android:textAllCaps="true"
                        android:textColor="@color/foodmind_green_100"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/generator_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:lineSpacingExtra="-1dp"
                        android:text="@string/generator_recommend_title"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/generator_support"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/generator_recommend_support"
                        android:textColor="@color/foodmind_green_100"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/generate_button"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="22dp"
                        android:minHeight="56dp"
                        android:text="@string/generate_recommendation"
                        android:textAllCaps="false"
                        android:textColor="@color/foodmind_green_950"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/foodmind_coral"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_sparkles"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        app:iconTint="@color/foodmind_green_950" />

                    <TextView
                        android:id="@+id/generator_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center"
                        android:text="@string/generator_hint_recommend"
                        android:textColor="#8FA99A"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/result_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#2D5A47" />

                        <TextView
                            android:id="@+id/result_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:background="@drawable/bg_match_pill"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:text="@string/result_match"
                            android:textColor="@color/foodmind_green_950"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/result_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="@string/result_restaurant_title"
                            android:textColor="@color/white"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/result_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/result_restaurant_meta"
                            android:textColor="@color/foodmind_green_100"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/result_reason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/result_restaurant_reason"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/result_primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/share_with_group"
                            android:textAllCaps="false"
                            android:textColor="@color/foodmind_green_950"
                            app:backgroundTint="@color/white"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_groups"
                            app:iconGravity="textStart"
                            app:iconTint="@color/foodmind_green_950" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/another_choice"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/try_another"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white"
                            app:strokeColor="#47705E"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/group_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/foodmind_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/group_eyebrow"
                                style="@style/FoodMind.SectionEyebrow"
                                android:text="@string/core_group" />

                            <TextView
                                android:id="@+id/group_title"
                                style="@style/FoodMind.SectionTitle"
                                android:layout_marginTop="5dp"
                                android:text="@string/kitchen_table" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="@color/foodmind_green_700"
                            android:textSize="25sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/group_support"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/group_card_support"
                        android:textColor="@color/foodmind_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/bg_group_signal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="13dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sparkles"
                            app:tint="@color/foodmind_green_700" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/group_signal_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/strongest_signal"
                                android:textColor="@color/foodmind_ink"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/group_signal_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/strongest_signal_value"
                                android:textColor="@color/foodmind_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/FoodMind.SectionEyebrow"
                android:layout_marginTop="29dp"
                android:text="@string/how_it_learns" />

            <TextView
                style="@style/FoodMind.SectionTitle"
                android:layout_marginTop="5dp"
                android:text="@string/every_choice_teaches" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/FoodMind.LearningCard">
                    <TextView
                        style="@style/FoodMind.LearningNumber"
                        android:text="01" />
                    <TextView
                        style="@style/FoodMind.LearningTitle"
                        android:text="@string/your_history" />
                    <TextView
                        style="@style/FoodMind.LearningSupport"
                        android:text="@string/history_support" />
                </LinearLayout>

                <LinearLayout
                    style="@style/FoodMind.LearningCard"
                    android:layout_marginStart="8dp">
                    <TextView
                        style="@style/FoodMind.LearningNumber"
                        android:text="02" />
                    <TextView
                        style="@style/FoodMind.LearningTitle"
                        android:text="@string/group_overlap" />
                    <TextView
                        style="@style/FoodMind.LearningSupport"
                        android:text="@string/group_overlap_support" />
                </LinearLayout>

                <LinearLayout
                    style="@style/FoodMind.LearningCard"
                    android:layout_marginStart="8dp">
                    <TextView
                        style="@style/FoodMind.LearningNumber"
                        android:text="03" />
                    <TextView
                        style="@style/FoodMind.LearningTitle"
                        android:text="@string/tonight_context" />
                    <TextView
                        style="@style/FoodMind.LearningSupport"
                        android:text="@string/tonight_context_support" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/explore_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FoodMind.SectionEyebrow"
                        android:text="@string/from_explore" />

                    <TextView
                        style="@style/FoodMind.SectionTitle"
                        android:layout_marginTop="5dp"
                        android:text="@string/ideas_passing_around" />
                </LinearLayout>

                <TextView
                    android:id="@+id/open_explore"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/browse"
                    android:textColor="@color/foodmind_green_700"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/explore_post_one"
                        style="@style/FoodMind.ExploreCard"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="116dp"
                                android:background="@drawable/bg_post_coral">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|start"
                                    android:layout_margin="12dp"
                                    android:background="@drawable/bg_post_tag"
                                    android:paddingStart="8dp"
                                    android:paddingTop="5dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="5dp"
                                    android:text="@string/quick_dinner"
                                    android:textColor="@color/white"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginEnd="14dp"
                                android:maxLines="2"
                                android:text="@string/explore_post_one_title"
                                android:textColor="@color/foodmind_ink"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="14dp"
                                android:text="@string/explore_post_one_meta"
                                android:textColor="@color/foodmind_faint"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/explore_post_two"
                        style="@style/FoodMind.ExploreCard"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="116dp"
                                android:background="@drawable/bg_post_sage">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|start"
                                    android:layout_margin="12dp"
                                    android:background="@drawable/bg_post_tag"
                                    android:paddingStart="8dp"
                                    android:paddingTop="5dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="5dp"
                                    android:text="@string/places"
                                    android:textColor="@color/white"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginEnd="14dp"
                                android:maxLines="2"
                                android:text="@string/explore_post_two_title"
                                android:textColor="@color/foodmind_ink"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="14dp"
                                android:text="@string/explore_post_two_meta"
                                android:textColor="@color/foodmind_faint"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
