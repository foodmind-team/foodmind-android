<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foodmind_paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <Button
            android:id="@+id/section_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/foodmind_green_700" />
        <TextView
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/foodmind_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
        <View android:layout_width="64dp" android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">
            <TextView
                android:id="@+id/section_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/foodmind_muted"
                android:textSize="14sp" />
            <com.google.android.material.card.MaterialCardView
                style="@style/FoodMind.SectionCard"
                android:layout_marginTop="24dp">
                <TextView
                    android:id="@+id/section_card_one"
                    style="@style/FoodMind.SectionCardText" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/FoodMind.SectionCard"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/section_card_two"
                    style="@style/FoodMind.SectionCardText" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/FoodMind.SectionCard"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/section_card_three"
                    style="@style/FoodMind.SectionCardText" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/section_mock_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/foodmind_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
