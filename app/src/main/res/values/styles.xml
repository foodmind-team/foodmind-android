<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FoodMind.MetaChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_meta_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">58dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/foodmind_green_100</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.SectionEyebrow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/foodmind_faint</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="FoodMind.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.QuickCard" parent="">
        <item name="android:layout_width">142dp</item>
        <item name="android:layout_height">126dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/foodmind_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/foodmind_green_100</item>
    </style>

    <style name="FoodMind.QuickCardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="FoodMind.QuickIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.QuickTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.QuickDescription" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/foodmind_faint</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="FoodMind.ProgressHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="FoodMind.ProgressLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/foodmind_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="FoodMind.ProgressValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:max">100</item>
        <item name="android:progressBackgroundTint">@color/foodmind_progress_track</item>
    </style>

    <style name="FoodMind.MealRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="FoodMind.MealBadge" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="FoodMind.MealTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.MealMeta" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/foodmind_faint</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="FoodMind.RowChevron" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/foodmind_faint</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="FoodMind.BottomNavigationItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="FoodMind.BottomNavigationIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
    </style>

    <style name="FoodMind.BottomNavigationLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/foodmind_faint</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="FoodMind.ModeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/mode_button_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/mode_button_background</item>
        <item name="cornerRadius">11dp</item>
        <item name="iconTint">@color/mode_button_text</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="FoodMind.StackedAvatar" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_avatar_mint</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/foodmind_green_700</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.GeneratorChip" parent="">
        <item name="android:layout_height">47dp</item>
        <item name="android:background">@drawable/bg_meta_chip</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/foodmind_green_100</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.LearningCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">128dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_learning_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="FoodMind.LearningNumber" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/foodmind_green_700</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.LearningTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.LearningSupport" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:maxLines">3</item>
        <item name="android:textColor">@color/foodmind_faint</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="FoodMind.ExploreCard" parent="">
        <item name="android:layout_width">210dp</item>
        <item name="android:layout_height">205dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/foodmind_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FoodMind.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/foodmind_green_950</item>
        <item name="backgroundTint">@color/foodmind_lime</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="FoodMind.RecipeCard" parent="">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/foodmind_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FoodMind.RecipeCheckbox" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FoodMind.PlanProgressCard" parent="">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/foodmind_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FoodMind.PlanTask" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FoodMind.SectionCard" parent="">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/foodmind_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FoodMind.SectionCardText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:textColor">@color/foodmind_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FoodMind.FixtureRadio" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/foodmind_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>
